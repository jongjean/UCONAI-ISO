// ISO schema draft only.
// Do not run migrations before the ISO database execution plan is reviewed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

enum ProjectRole {
  SYSTEM_ADMIN
  PROJECT_LEAD
  EDITOR
  RESEARCHER
  REVIEWER
  VIEWER
}

enum DeliverableType {
  IS
  TS
  TR
  PAS
  IWA
  GUIDE
}

enum ProjectStage {
  PWI
  NP
  WD
  CD
  DIS
  FDIS
  PUBLICATION
}

enum TrackLength {
  MONTHS_18
  MONTHS_24
  MONTHS_36
}

enum ElementType {
  TITLE
  FOREWORD
  INTRODUCTION
  SCOPE
  NORMATIVE_REFERENCES
  TERM
  ABBREVIATION
  CLAUSE
  PARAGRAPH
  LIST
  NOTE
  EXAMPLE
  TABLE
  FIGURE
  ANNEX
  BIBLIOGRAPHY
}

enum SourceClass {
  OFFICIAL_RULE
  OFFICIAL_GUIDANCE
  PROJECT_POLICY
  EXPERT_HEURISTIC
  AI_INFERENCE
  USER_NOTE
}

enum AiUseMode {
  EXCLUDE
  SUMMARIZE
  COMPARE
  QUOTE_LIMITED
  PENDING
}

enum ExportType {
  WORKING_DRAFT_DOCX
  CLEAN_DOCX
  REDLINE_DOCX
  COMMENTED_DOCX
  OSD_COMPANION_REPORT
  ASSET_PACKAGE
}

enum RoadmapEventType {
  MILESTONE
  MEETING
  BALLOT
  CONSULTATION
  SUBMISSION
  MISSION
}

enum DispositionDecision {
  ACCEPTED
  REJECTED
  MODIFIED
  DEFERRED
}

enum ValidationSeverity {
  INFO
  WARNING
  BLOCKER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String?    @map("display_name")
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  externalIdentities ExternalIdentity[]
  memberships        ProjectMember[]
  createdSnapshots   DocumentVersionSnapshot[]
  heldLocks          EditOwnershipLock[]
  aiInteractions     AiInteraction[]
  aiProviderUsage    AiProviderUsage[]
  usageLedger        UsageLedger[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]

  @@map("users")
}

model ExternalIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String
  externalId String   @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("external_identities")
}

model DeliverableProfile {
  id          String          @id @default(uuid()) @db.Uuid
  type        DeliverableType @unique
  label       String
  description String?
  ruleSet     Json            @default("{}") @map("rule_set")
  createdAt   DateTime        @default(now()) @map("created_at")

  projects StandardProject[]

  @@map("deliverable_profiles")
}

model StandardProject {
  id                   String       @id @default(uuid()) @db.Uuid
  slug                 String       @unique
  title                String
  committee            String?
  stage                ProjectStage @default(PWI)
  track                TrackLength  @default(MONTHS_36)
  deliverableProfileId String       @map("deliverable_profile_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  archivedAt           DateTime?    @map("archived_at")

  deliverableProfile DeliverableProfile @relation(fields: [deliverableProfileId], references: [id])
  members            ProjectMember[]
  stageTrackPlans    StageTrackPlan[]
  roadmapEvents      RoadmapEvent[]
  meetingEvents      MeetingEvent[]
  voteEvents         VoteEvent[]
  documentElements   DocumentElement[]
  editLocks          EditOwnershipLock[]
  references         ReferenceDocument[]
  normativeReferences NormativeReference[]
  bibliographyCandidates BibliographyLinkCandidate[]
  figures            FigureAsset[]
  exportJobs         ExportJob[]
  committeeActors    CommitteeActor[]
  commentDispositions CommentDisposition[]
  decisionRecords    DecisionRecord[]
  aiInteractions     AiInteraction[]
  aiProviderUsage    AiProviderUsage[]
  usageLedger        UsageLedger[]
  securityEvents     SecurityEvent[]
  auditLogs          AuditLog[]

  @@index([deliverableProfileId])
  @@index([stage, track])
  @@map("standard_projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, role])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model StageTrackPlan {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  track     TrackLength
  startsOn  DateTime?   @map("starts_on")
  targetOn  DateTime?   @map("target_on")
  planData  Json        @default("{}") @map("plan_data")
  createdAt DateTime    @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, track])
  @@map("stage_track_plans")
}

model RoadmapEvent {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  stage     ProjectStage?
  title     String
  eventType RoadmapEventType @default(MILESTONE) @map("event_type")
  dueAt     DateTime?    @map("due_at")
  mission   String?
  status    String       @default("PLANNED")
  createdAt DateTime     @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stage])
  @@index([projectId, dueAt])
  @@map("roadmap_events")
}

model MeetingEvent {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  stage     ProjectStage?
  title     String
  startsAt  DateTime?    @map("starts_at")
  location  String?
  agenda    Json         @default("{}")
  attendance Json        @default("{}")
  evidence  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startsAt])
  @@map("meeting_events")
}

model VoteEvent {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  stage     ProjectStage
  title     String
  opensAt   DateTime?    @map("opens_at")
  closesAt  DateTime?    @map("closes_at")
  result    Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stage])
  @@index([projectId, opensAt, closesAt])
  @@map("vote_events")
}

model DocumentElement {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  parentId    String?     @map("parent_id") @db.Uuid
  type        ElementType
  stableKey   String      @map("stable_key")
  title       String?
  content     String?
  sortOrder   Int         @default(0) @map("sort_order")
  numbering   String?
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  project   StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    DocumentElement? @relation("ElementTree", fields: [parentId], references: [id])
  children  DocumentElement[] @relation("ElementTree")
  snapshots DocumentVersionSnapshot[]
  bibliographyCandidates BibliographyLinkCandidate[]
  figures FigureAsset[]
  commentDispositions CommentDisposition[]

  @@unique([projectId, stableKey])
  @@index([projectId, parentId])
  @@index([projectId, type])
  @@index([parentId])
  @@map("document_elements")
}

model DocumentVersionSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  elementId   String   @map("element_id") @db.Uuid
  versionNo   Int      @map("version_no")
  snapshot    Json
  reason      String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  element DocumentElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([elementId, versionNo])
  @@index([elementId])
  @@index([createdById])
  @@map("document_version_snapshots")
}

model EditOwnershipLock {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  holderId  String    @map("holder_id") @db.Uuid
  reason    String?
  acquiredAt DateTime @default(now()) @map("acquired_at")
  expiresAt DateTime? @map("expires_at")
  releasedAt DateTime? @map("released_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  holder  User            @relation(fields: [holderId], references: [id])

  @@index([projectId, releasedAt])
  @@index([holderId])
  @@map("edit_ownership_locks")
}

model ReferenceDocument {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  sourceUrl   String?   @map("source_url")
  storageKey  String?   @map("storage_key")
  sourceClass SourceClass @map("source_class")
  aiUseMode   AiUseMode @default(PENDING) @map("ai_use_mode")
  checksum    String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  normativeReferences NormativeReference[]
  bibliographyCandidates BibliographyLinkCandidate[]

  @@index([projectId, sourceClass])
  @@index([projectId, aiUseMode])
  @@map("reference_documents")
}

model NormativeReference {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  referenceId String?  @map("reference_id") @db.Uuid
  label       String
  citation    String
  approved    Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reference ReferenceDocument? @relation(fields: [referenceId], references: [id])

  @@index([projectId, sortOrder])
  @@index([referenceId])
  @@map("normative_references")
}

model BibliographyLinkCandidate {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  elementId   String?  @map("element_id") @db.Uuid
  referenceId String?  @map("reference_id") @db.Uuid
  note        String
  status      String   @default("CANDIDATE")
  createdAt   DateTime @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  element DocumentElement? @relation(fields: [elementId], references: [id])
  reference ReferenceDocument? @relation(fields: [referenceId], references: [id])

  @@index([projectId, status])
  @@index([elementId])
  @@index([referenceId])
  @@map("bibliography_link_candidates")
}

model FigureAsset {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  elementId   String?  @map("element_id") @db.Uuid
  label       String
  previewKey  String?  @map("preview_key")
  sourceKey   String?  @map("source_key")
  sourceType  String?  @map("source_type")
  editable    Boolean  @default(false)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  element DocumentElement? @relation(fields: [elementId], references: [id])
  validations AssetSourceValidation[]

  @@index([projectId, elementId])
  @@index([editable])
  @@map("figure_assets")
}

model AssetSourceValidation {
  id        String             @id @default(uuid()) @db.Uuid
  figureId  String             @map("figure_id") @db.Uuid
  severity  ValidationSeverity
  code      String
  message   String
  metadata  Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at")

  figure FigureAsset @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@index([figureId, severity])
  @@map("asset_source_validations")
}

model CommitteeActor {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  name         String
  country      String?
  organization String?
  role         String?
  position     String   @default("UNKNOWN")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments CommentDisposition[]

  @@index([projectId, country])
  @@index([projectId, position])
  @@map("committee_actors")
}

model CommentDisposition {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @map("project_id") @db.Uuid
  actorId   String?             @map("actor_id") @db.Uuid
  elementId String?             @map("element_id") @db.Uuid
  comment   String
  response  String?
  decision  DispositionDecision?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   CommitteeActor? @relation(fields: [actorId], references: [id])
  element DocumentElement? @relation(fields: [elementId], references: [id])

  @@index([projectId, decision])
  @@index([actorId])
  @@index([elementId])
  @@map("comment_dispositions")
}

model DecisionRecord {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  title     String
  decision  String
  rationale String?
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("decision_records")
}

model AiInteraction {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  agent     String
  provider  String
  model     String?
  purpose   String
  inputHash String?  @map("input_hash")
  outputRef String?  @map("output_ref")
  createdAt DateTime @default(now()) @map("created_at")

  project StandardProject? @relation(fields: [projectId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("ai_interactions")
}

model AiProviderUsage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  provider  String
  model     String?
  purpose   String
  inputUnits Int?    @map("input_units")
  outputUnits Int?   @map("output_units")
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12, 4)
  createdAt DateTime @default(now()) @map("created_at")

  project StandardProject? @relation(fields: [projectId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([provider, model])
  @@map("ai_provider_usage")
}

model ExportJob {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  type      ExportType
  status    String     @default("PENDING")
  storageKey String?   @map("storage_key")
  checksum  String?
  metadata  Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")

  project StandardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("export_jobs")
}

model CreditAccount {
  id        String   @id @default(uuid()) @db.Uuid
  ownerType String   @map("owner_type")
  ownerId   String   @map("owner_id")
  balance   Decimal  @default(0) @db.Decimal(12, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events BillingEvent[]

  @@unique([ownerType, ownerId])
  @@map("credit_accounts")
}

model BillingEvent {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  type      String
  amount    Decimal @db.Decimal(12, 4)
  reason    String?
  metadata  Json    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("billing_events")
}

model UsageLedger {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  provider  String
  model     String?
  purpose   String
  amount    Decimal? @db.Decimal(12, 4)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  project StandardProject? @relation(fields: [projectId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([provider, model])
  @@map("usage_ledger")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  target    String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  project StandardProject? @relation(fields: [projectId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  severity  String   @default("INFO")
  detail    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  project StandardProject? @relation(fields: [projectId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([eventType, severity])
  @@map("security_events")
}

