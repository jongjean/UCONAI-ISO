  "deliverables": [
    {
      "code": "IS",
      "label": "International Standard",
      "engineMode": "normative-standard"
    },
    {
      "code": "TS",
      "label": "Technical Specification",
      "engineMode": "technical-specification"
    },
    {
      "code": "TR",
      "label": "Technical Report",
      "engineMode": "informative-report"
    },
    {
      "code": "PAS",
      "label": "Publicly Available Specification",
      "engineMode": "urgent-market-specification"
    },
    {
      "code": "IWA",
      "label": "International Workshop Agreement",
      "engineMode": "workshop-agreement"
    },
    {
      "code": "GUIDE",
      "label": "ISO Guide",
      "engineMode": "guidance-document"
    }
  ],
  "stages": ["PWI", "NP", "WD", "CD", "DIS", "FDIS", "PUBLICATION"],
  "ruleClasses": ["OFFICIAL_RULE", "OFFICIAL_GUIDANCE", "PROJECT_POLICY", "EXPERT_HEURISTIC", "AI_INFERENCE", "USER_NOTE"],
  "rules": [
    {
      "id": "ISO-SRC-001",
      "title": "Official source precedence",
      "class": "PROJECT_POLICY",
      "sourceIds": ["iso-directives-and-policies", "iso-directives-part-1-consolidated", "iso-directives-part-2"],
      "severity": "BLOCKER",
      "workflowEffect": "HUMAN_REVIEW_REQUIRED",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["PWI", "NP", "WD", "CD", "DIS", "FDIS", "PUBLICATION"],
        "documentAreas": ["export"]
      },
      "guidance": "When project memory, AI output, and official source material conflict, official ISO/IEC source material must govern the product decision."
    },
    {
      "id": "ISO-DOC-001",
      "title": "Scope text stability",
      "class": "EXPERT_HEURISTIC",
      "sourceIds": ["iso-directives-part-2"],
      "severity": "WARNING",
      "workflowEffect": "STAGE_GATE",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["NP", "WD", "CD", "DIS", "FDIS"],
        "documentAreas": ["scope"]
      },
      "guidance": "Scope changes after committee alignment can have procedural and consensus consequences, so the editor must show change history, impact notes, and stakeholder rationale."
    },
    {
      "id": "ISO-DOC-002",
      "title": "Structured clause numbering",
      "class": "OFFICIAL_GUIDANCE",
      "sourceIds": ["iso-directives-part-2", "iso-drafting-standards"],
      "severity": "WARNING",
      "workflowEffect": "EDITOR_WARNING",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["WD", "CD", "DIS", "FDIS", "PUBLICATION"],
        "documentAreas": ["clauses", "terms", "figures", "tables"]
      },
      "guidance": "Document structure must be managed as numbered elements, not pasted free text, so insertion, deletion, and OSD export remain stable."
    },
    {
      "id": "ISO-TERM-001",
      "title": "Term entry caution",
      "class": "EXPERT_HEURISTIC",
      "sourceIds": ["iso-directives-part-2", "iso-drafting-standards"],
      "severity": "WARNING",
      "workflowEffect": "EDITOR_WARNING",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["WD", "CD", "DIS", "FDIS"],
        "documentAreas": ["terms", "abbreviations"]
      },
      "guidance": "Term, definition, and abbreviation edits must preserve conceptual consistency across title, scope, clauses, figures, and bibliography candidates."
    },
    {
      "id": "ISO-REF-001",
      "title": "Reference use intent",
      "class": "PROJECT_POLICY",
      "sourceIds": ["iso-directives-part-2"],
      "severity": "WARNING",
      "workflowEffect": "INLINE_HINT",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["PWI", "NP", "WD", "CD", "DIS", "FDIS"],
        "documentAreas": ["normativeReferences", "bibliography"]
      },
      "guidance": "Every registered reference must record whether it may be summarized, compared, excluded, or later linked as bibliography evidence."
    },
    {
      "id": "ISO-FIG-001",
      "title": "Editable figure source readiness",
      "class": "PROJECT_POLICY",
      "sourceIds": ["iso-drafting-standards", "iso-osd-kb"],
      "severity": "BLOCKER",
      "workflowEffect": "EXPORT_GATE",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["DIS", "FDIS", "PUBLICATION"],
        "documentAreas": ["figures", "export"]
      },
      "guidance": "A raster preview is not enough for final submission readiness; editable source packages must be tracked for diagrams where text or shapes may need committee or production edits."
    },
    {
      "id": "ISO-ROAD-001",
      "title": "Track recalculation visibility",
      "class": "PROJECT_POLICY",
      "sourceIds": ["iso-directives-part-1-consolidated"],
      "severity": "WARNING",
      "workflowEffect": "STAGE_GATE",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["PWI", "NP", "WD", "CD", "DIS", "FDIS"],
        "documentAreas": ["export"]
      },
      "guidance": "When the project track changes between 36, 24, and 18 months, the roadmap must expose affected milestones, minimum windows, ballots, consultations, and meeting missions."
    },
    {
      "id": "ISO-CONS-001",
      "title": "Consensus mission trace",
      "class": "EXPERT_HEURISTIC",
      "sourceIds": ["iso-directives-part-1-consolidated"],
      "severity": "INFO",
      "workflowEffect": "INLINE_HINT",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["PWI", "NP", "WD", "CD", "DIS"],
        "documentAreas": ["scope", "clauses"]
      },
      "guidance": "Meeting preparation should identify who needs to understand, support, challenge, or soften objections before the next procedural milestone."
    },
    {
      "id": "ISO-OSD-001",
      "title": "OSD companion readiness",
      "class": "OFFICIAL_GUIDANCE",
      "sourceIds": ["iso-osd-kb", "iso-osd-overview", "iso-osd-adoption"],
      "severity": "WARNING",
      "workflowEffect": "EXPORT_GATE",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["WD", "CD", "DIS", "FDIS", "PUBLICATION"],
        "documentAreas": ["export"]
      },
      "guidance": "The platform prepares structured drafting support before OSD entry, while treating OSD as the official online development environment where applicable."
    },
    {
      "id": "ISO-AI-001",
      "title": "AI output cannot silently become canonical text",
      "class": "PROJECT_POLICY",
      "sourceIds": ["iso-directives-part-2", "iso-drafting-standards"],
      "severity": "BLOCKER",
      "workflowEffect": "HUMAN_REVIEW_REQUIRED",
      "appliesTo": {
        "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
        "stages": ["PWI", "NP", "WD", "CD", "DIS", "FDIS"],
        "documentAreas": ["title", "scope", "introduction", "terms", "abbreviations", "clauses"]
      },
      "guidance": "AI suggestions must remain proposed text until an authorized editor accepts them into the structured document history."
    }
  ]
}
