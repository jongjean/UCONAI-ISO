{
  "version": "0.1.0",
  "updatedAt": "2026-05-03",
  "sourcePolicy": {
    "officialRulesCanBlock": true,
    "officialGuidanceCanWarn": true,
    "expertHeuristicsAreAdvisory": true,
    "aiInferencesRequireHumanReview": true
  },
  "ruleIdPolicy": {
    "pattern": "^ISO-[A-Z]{2,8}-[0-9]{3}$",
    "format": "ISO-{DOMAIN}-{NNN}",
    "domains": ["SRC", "DOC", "TERM", "REF", "FIG", "ROAD", "CONS", "OSD", "AI"],
    "stability": "Rule IDs are immutable once referenced by document history, validation events, or export reports."
  },
  "severityLevels": [
    {
      "code": "INFO",
      "effect": "Explain context or best practice without blocking progress."
    },
    {
      "code": "WARNING",
      "effect": "Require visible guidance and an explicit user decision before final export."
    },
    {
      "code": "BLOCKER",
      "effect": "Block stage transition or export until resolved or formally waived by a project lead."
    }
  ],
  "workflowEffects": [
    "INLINE_HINT",
    "EDITOR_WARNING",
    "STAGE_GATE",
    "EXPORT_GATE",
    "HUMAN_REVIEW_REQUIRED"
  ],
  "applicability": {
    "deliverables": ["IS", "TS", "TR", "PAS", "IWA", "GUIDE"],
    "stages": ["PWI", "NP", "WD", "CD", "DIS", "FDIS", "PUBLICATION"],
    "documentAreas": [
      "title",
      "scope",
      "introduction",
      "terms",
      "abbreviations",
      "normativeReferences",
      "clauses",
      "figures",
      "tables",
      "bibliography",
      "export"
    ]
  },
  "sources": [
